#!/bin/bash

# file build_helper.af
# brief Helper script to install dependencies for AF microservice
# author Tariro Mukute, phine.tech

################################
# include helper functions
################################
SCRIPT=$(readlink -f ${BASH_SOURCE})
THIS_SCRIPT_PATH=`dirname $SCRIPT`
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
BUILD_DIR="${PROJECT_ROOT}/build-output"

source "${PROJECT_ROOT}/common/build/scripts/build_helper.protobuf"
source "${PROJECT_ROOT}/common/build/scripts/build_helper.grpc"
source "${PROJECT_ROOT}/common/build/scripts/build_helper.openssl"
source "${PROJECT_ROOT}/common/build/scripts/build_helper.nghttp2"
source "${PROJECT_ROOT}/common/build/scripts/build_helper.nlohmann"
source "${PROJECT_ROOT}/common/build/scripts/build_helper.spdlog"
source "${PROJECT_ROOT}/common/build/scripts/build_helper.yamlcpp"

# Determine the OS distribution
OS_DISTRO=$(grep "^ID=" /etc/os-release | sed "s/ID=//" | sed "s/\"//g")
OS_RELEASE=$(grep "^VERSION_ID=" /etc/os-release | sed "s/VERSION_ID=//" | sed "s/\"//g")
OS_BASEDISTRO=$(grep -e "^ID_LIKE=" /etc/os-release | sed "s/ID_LIKE=//" | sed "s/\"//g" | cut -d ' ' -f1)

# Check if running in a container
IS_CONTAINER=0
if [ -f /.dockerenv ] || grep -q 'container=lxc' /proc/1/environ || grep -q 'container=podman' /proc/1/environ; then
    IS_CONTAINER=1
fi

# Set the appropriate installer command
if [[ $OS_DISTRO == "ubuntu" ]]; then
    INSTALLER="apt-get"
    CMAKE="cmake"
elif [[ "$OS_BASEDISTRO" == "fedora" ]]; then
    INSTALLER="dnf"
    CMAKE="cmake"
else
    INSTALLER="apt-get"
    CMAKE="cmake"
fi

IS_DOCKERBUILD=${IS_DOCKERFILE:-0}

if [ $IS_CONTAINER -eq 0 ] && [ $IS_DOCKERBUILD -eq 0 ]
then
  SUDO='sudo -S -E'
else
  SUDO=''
  IS_CONTAINER=1
fi

# Check if command failed
check_command_failure() {
    if [ $? -ne 0 ]; then
        echo -e "\e[31mCommand failed: $1\e[0m"
        exit 1
    else
        echo -e "\e[32mCommand succeeded: $1\e[0m"
    fi
}

# Get distribution release
get_distribution_release() {
    if [[ ! -z "$OS_DISTRO$OS_RELEASE" ]]; then
        echo "$OS_DISTRO$OS_RELEASE"
    else
        echo "Unknown"
    fi
}

# Check if distribution is supported
check_supported_distribution() {
    local distribution=$(get_distribution_release)
    case "$distribution" in
        "ubuntu20.04" | "ubuntu22.04")
            echo "Distribution $distribution is supported"
            return 0
            ;;
        "debian11" | "debian12")
            echo "Distribution $distribution is supported"
            return 0
            ;;
        "rhel8" | "centos8" | "fedora")
            echo "Distribution $distribution is supported"
            return 0
            ;;
        *)
            echo "Distribution $distribution is not supported"
            return 1
            ;;
    esac
}

# Update package database
update_package_db() {
    if [[ $OS_DISTRO == "ubuntu" ]]; then
        $SUDO $INSTALLER update -y
    elif [[ "$OS_BASEDISTRO" == "fedora" ]]; then
        $SUDO $INSTALLER update -y
    elif [[ $OS_DISTRO == "debian" ]]; then
        $SUDO $INSTALLER update -y
    fi
    check_command_failure "Updating package database"
}

# Enable EPEL repositories for RHEL/CentOS
check_enable_epel_repos() {
    if [[ "$OS_BASEDISTRO" == "fedora" ]]; then
        if [[ $OS_DISTRO == "rhel" ]] || [[ $OS_DISTRO == "centos" ]]; then
            $SUDO $INSTALLER install -y https://dl.fedoraproject.org/pub/epel/epel-release-latest-8.noarch.rpm
            check_command_failure "Installing EPEL repository"
        fi
    fi
}

# Main function to check and install dependencies
# arg1 is force (0 or 1) (no interactive script)
# arg2 is debug (0 or 1) (install debug libraries)
check_install_af_deps() {
    local force=$1
    local debug=$2
    
    if [ $force -gt 0 ]; then
        OPTION="-y"
    else
        OPTION="-y"
    fi
    
    echo "Checking supported distribution"
    check_supported_distribution
    [[ $? -ne 0 ]] && return $?
    
    # Prevent lock on package manager
    if [[ $OS_DISTRO == "ubuntu" ]]; then
        if [ $IS_CONTAINER -eq 0 ]; then
            $SUDO sed -i 's/1/0/g' /etc/apt/apt.conf.d/10periodic
        fi
    fi
    
    update_package_db
    
    check_enable_epel_repos
    
    # Install basic build tools
    if [[ $OS_DISTRO == "ubuntu" ]]; then
        PACKAGE_LIST="\
            autoconf \
            automake \
            build-essential \
            $CMAKE \
            curl \
            git \
            libtool \
            pkg-config \
            libssl-dev \
            libboost-all-dev"
    elif [[ "$OS_BASEDISTRO" == "fedora" ]]; then
        PACKAGE_LIST="\
            autoconf \
            automake \
            gcc-c++ \
            $CMAKE \
            make \
            git \
            libtool \
            pkgconfig \
            openssl-devel \
            boost-devel"
    elif [[ "$OS_DISTRO" == "debian" ]]; then
        PACKAGE_LIST="\
            autoconf \
            automake \
            build-essential \
            $CMAKE \
            curl \
            git \
            libtool \
            pkg-config \
            libssl-dev \
            libboost-all-dev"
    else
        echo "Error: $OS_DISTRO is not a supported distribution."
        return 1
    fi
    
    echo "Installing build tools"
    $SUDO $INSTALLER install $OPTION $PACKAGE_LIST
    ret=$?; [[ $ret -ne 0 ]] && return $ret
    
    # Install Protocol Buffers
    install_protobuf_from_git $force $debug
    ret=$?; [[ $ret -ne 0 ]] && return $ret
    
    # Install gRPC (optional)
    if [ $force -gt 0 ]; then
        # When force is enabled, install gRPC
        install_grpc_from_git $force $debug
        ret=$?; [[ $ret -ne 0 ]] && return $ret
    else
        echo "gRPC installation is optional. To install it, run this script with --force"
    fi
    
    # Install yaml-cpp
    install_yaml_cpp_from_git $force $debug
    ret=$?; [[ $ret -ne 0 ]] && return $ret
    
    # Install nlohmann/json
    install_nlohmann_json_from_git $force $debug
    ret=$?; [[ $ret -ne 0 ]] && return $ret
    
    # Install spdlog
    install_spdlog_from_git $force $debug
    ret=$?; [[ $ret -ne 0 ]] && return $ret

    # Install OpenSSL
    install_openssl $force $debug
    ret=$?; [[ $ret -ne 0 ]] && return $ret
    
    # Install nghttp2 with ASIO bindings
    install_nghttp2_from_git $force $debug
    ret=$?; [[ $ret -ne 0 ]] && return $ret

    install_nghttp2_asio_from_git $force $debug
    ret=$?; [[ $ret -ne 0 ]] && return $ret


    $SUDO ldconfig
    
    echo "All dependencies installed successfully"
    return 0
}